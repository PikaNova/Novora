# 复制为 .env 后填写真实值，不要提交到仓库。
# 本地 Docker 部署：compose 会自动注入 DATABASE_URL 指向内嵌 postgres 服务，这一项可以留空。
# Vercel/Neon 云端部署：填写 Neon 连接串。
# DATABASE_URL=postgresql://user:password@xxx.neon.tech/neondb?sslmode=require&channel_binding=require

# 首次启动超级管理员（可选；未配置时走原有恢复流程）
# ADMIN_PASSWORD=
# ADMIN_RECOVERY_KEY=

# 服务端口（本地 HTTP 部署）
PORT=3000
# CORS_ALLOWED_ORIGINS=

# 遥测与公告图上游。注意：公告正文图片依赖远端服务（/api/announcement-images 转发），
# 纯离线环境下公告图不可用，其余功能不受影响。注意：TELEMETRY_* 留空时仍会回传作者端（telemetry.pikachu2026.space），带 5 秒超时，失败不影响使用。
# TELEMETRY_BASE_URL=
# TELEMETRY_COLLECT_URL=
# TELEMETRY_TOKEN_URL=
# TELEMETRY_ANNOUNCE_URL=
# TELEMETRY_ERROR_REPORT_URL=
# TELEMETRY_IP_SALT=

# 更新检查 / 部署钩子（本地可全部留空，功能自动禁用）
# GITHUB_REPO=PikaNova/Novora
# GITHUB_TOKEN=
# VERCEL_DEPLOY_HOOK_URL=

# 诊断日志重试队列 worker（/api/diagnostic-worker）。留空时该端点与 /api/email-worker 一样开放，
# 只返回计数、不返回日志正文；填写后要求 Authorization: Bearer <值> 或 x-cron-secret: <值>。
# DIAGNOSTIC_WORKER_SECRET=

# 入口限流调优（可选，有安全默认值）
# ENTRY_RATE_LIMIT_MAX_REQUESTS=30
# ENTRY_RATE_LIMIT_WINDOW_MS=10000
# ENTRY_RATE_LIMIT_WRITE_MAX_REQUESTS=8
# ENTRY_RATE_LIMIT_WRITE_WINDOW_MS=10000

# Docker 可选：Docker daemon 国内镜像加速（/etc/docker/daemon.json 配置 registry-mirrors，如 https://docker.m.daocloud.io），
# 加速基础镜像拉取；无需在 .env 中设置额外变量。

# Docker 构建 npm 镜像源（默认国内 npmmirror，可按需覆盖）
# NPM_REGISTRY=https://registry.npmmirror.com

# 数据库集成测试专用。必须指向一次性数据库；测试会清空其中业务数据。
# 绝不要填写生产 DATABASE_URL，也不要与上方 DATABASE_URL 相同。
# INTEGRATION_DATABASE_URL=postgres://novora:novora@localhost:15432/novora_integration
# INTEGRATION_TEST_CONFIRM=novora-disposable
# INTEGRATION_DB_PORT=15432

# 前端构建开关：本地构建设为 false 以关闭 Vercel Speed Insights
VITE_SPEED_INSIGHTS=false
