{
  "name": "novora",
  "version": "2.7.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "test": "node -e \"require('node:fs').rmSync('.test-check', { recursive: true, force: true })\" && tsc -p tsconfig.test.json && node scripts/prepare-test-output.cjs && node --test .test-check/tests/*.test.js",
    "test:integration": "node scripts/run-integration-tests.cjs",
    "backfill:track-class-ids": "node scripts/run-track-backfill.cjs",
    "typecheck:api": "tsc -p tsconfig.api.json && node -e \"import('./.api-check/api/exams.js')\""
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.5",
    "@vercel/speed-insights": "^1.2.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^5.8.27",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
