<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色令牌：键集合必须与 Tokens.Dark.xaml 完全一致 -->
    <!-- 三档表面：画布最深、导航居中、卡片最高，靠底色而不是阴影分层 -->
    <Color x:Key="WindowBackgroundColor">#EAEFF5</Color>
    <SolidColorBrush x:Key="WindowBackground" Color="#EAEFF5" />
    <SolidColorBrush x:Key="RailBackground" Color="#F7F9FC" />
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SoftBackground" Color="#F4F7FB" />
    <SolidColorBrush x:Key="HoverBackground" Color="#F1F5F9" />
    <SolidColorBrush x:Key="PressedBackground" Color="#E6EDF6" />
    <SolidColorBrush x:Key="Border" Color="#DDE5EE" />
    <SolidColorBrush x:Key="CardBorder" Color="#D3DDE9" />
    <SolidColorBrush x:Key="BorderStrong" Color="#C3CFDD" />
    <SolidColorBrush x:Key="BorderWeak" Color="#EAF0F6" />
    <SolidColorBrush x:Key="Focus" Color="#1D4ED8" />
    <SolidColorBrush x:Key="TextPrimary" Color="#141C26" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5A6675" />
    <SolidColorBrush x:Key="TextTertiary" Color="#8B97A6" />
    <SolidColorBrush x:Key="DisabledBackground" Color="#EDF1F6" />
    <SolidColorBrush x:Key="DisabledText" Color="#A3AEBA" />
    <!-- 名字不能与 Controls.xaml 里的样式键重名：DynamicResource 不看类型，
         样式查找会命中同名画刷并在赋值时抛异常。 -->
    <SolidColorBrush x:Key="SkeletonFill" Color="#E2E9F2" />
    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#EAF1FE" />
    <SolidColorBrush x:Key="Success" Color="#16803C" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#E7F7EC" />
    <SolidColorBrush x:Key="Warning" Color="#8A4C00" />
    <SolidColorBrush x:Key="WarningSoft" Color="#FDF1D8" />
    <SolidColorBrush x:Key="Danger" Color="#B42318" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FDECEA" />
    <SolidColorBrush x:Key="Track" Color="#E1E8F1" />
    <SolidColorBrush x:Key="ShadowColor" Color="#0F172A" />
    <SolidColorBrush x:Key="CaptionAccent" Color="#12B7F5" />
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="NumberFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
</ResourceDictionary>
