<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色令牌：键集合必须与 Tokens.Light.xaml 完全一致 -->
    <!-- 三档表面：画布最深、导航居中、卡片最高；深色下阴影几乎不可见，靠 CardBorder 描边分层 -->
    <Color x:Key="WindowBackgroundColor">#121417</Color>
    <SolidColorBrush x:Key="WindowBackground" Color="#121417" />
    <SolidColorBrush x:Key="RailBackground" Color="#1A1D21" />
    <SolidColorBrush x:Key="CardBackground" Color="#23272B" />
    <SolidColorBrush x:Key="SoftBackground" Color="#1F2327" />
    <SolidColorBrush x:Key="HoverBackground" Color="#2C3238" />
    <SolidColorBrush x:Key="PressedBackground" Color="#353C43" />
    <SolidColorBrush x:Key="Border" Color="#343A41" />
    <SolidColorBrush x:Key="CardBorder" Color="#414A54" />
    <SolidColorBrush x:Key="BorderStrong" Color="#4E5862" />
    <SolidColorBrush x:Key="BorderWeak" Color="#2B3036" />
    <SolidColorBrush x:Key="Focus" Color="#60A5FA" />
    <SolidColorBrush x:Key="TextPrimary" Color="#E9EBED" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A6AEB7" />
    <SolidColorBrush x:Key="TextTertiary" Color="#848D96" />
    <SolidColorBrush x:Key="DisabledBackground" Color="#272C31" />
    <SolidColorBrush x:Key="DisabledText" Color="#6C757F" />
    <!-- 名字不能与 Controls.xaml 里的样式键重名：DynamicResource 不看类型，
         样式查找会命中同名画刷并在赋值时抛异常。 -->
    <SolidColorBrush x:Key="SkeletonFill" Color="#2C333A" />
    <SolidColorBrush x:Key="Accent" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHover" Color="#60A5FA" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#17253E" />
    <SolidColorBrush x:Key="Success" Color="#4ADE80" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#122C1C" />
    <SolidColorBrush x:Key="Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="WarningSoft" Color="#2E2614" />
    <SolidColorBrush x:Key="Danger" Color="#F87171" />
    <SolidColorBrush x:Key="DangerSoft" Color="#311A19" />
    <SolidColorBrush x:Key="Track" Color="#2E343A" />
    <SolidColorBrush x:Key="ShadowColor" Color="#000000" />
    <SolidColorBrush x:Key="CaptionAccent" Color="#45C7F5" />
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="NumberFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
</ResourceDictionary>
