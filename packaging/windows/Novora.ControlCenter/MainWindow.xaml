<Window x:Class="Novora.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Novora.ControlCenter"
        Title="Novora 控制中心" Width="1280" Height="852" MinWidth="1000" MinHeight="640"
        Background="{DynamicResource WindowBackground}" FontFamily="{DynamicResource UiFont}" FontSize="13"
        Icon="favicon.ico" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <!-- 用系统标题栏：自绘 WindowChrome 会吃掉最小化/最大化/关闭按钮和 Win11 贴靠布局，
         也带来最大化时 4px 溢出的老问题。品牌栏留在标题栏下方当工具条。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 品牌栏：系统标题栏下方这条当工具条用，卡片白底 + 蓝色分隔线与灰色画布分层 -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CaptionAccent}" BorderThickness="0,0,0,2">
            <Grid Margin="18,0,150,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="favicon.ico" Width="20" Height="20" VerticalAlignment="Center" />
                    <TextBlock Text="NOVORA" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Border Width="1" Height="16" Margin="12,0,12,1" Background="{DynamicResource Border}" />
                    <TextBlock Text="Windows 控制中心" Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <!-- 版本区：读不到版本时也要像一条状态，而不是一个"未知"占位 -->
                <Border Style="{DynamicResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="VersionDot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                 Fill="{DynamicResource TextTertiary}" />
                        <TextBlock x:Name="VersionText" Text="正在读取运行状态" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航：中间档底色，比画布浅、比卡片深，选中项才用纯白浮起 -->
            <Border x:Name="SidePanel" Width="208" Background="{DynamicResource RailBackground}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="10,14,10,14">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <Button x:Name="NavOverview" Style="{DynamicResource NavItem}" Tag="overview" Click="Nav_Click"
                                AutomationProperties.Name="运行总览" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="{DynamicResource IconFont}" FontSize="15" Width="20" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="运行总览" VerticalAlignment="Center" />
                                <Ellipse x:Name="NavOverviewDot" Width="7" Height="7" Margin="8,0,0,0" VerticalAlignment="Center"
                                         Fill="{DynamicResource TextTertiary}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSetup" Style="{DynamicResource NavItem}" Tag="setup" Click="Nav_Click" AutomationProperties.Name="初始化">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" FontSize="15" Width="20" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="初始化" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSettings" Style="{DynamicResource NavItem}" Tag="settings" Click="Nav_Click" AutomationProperties.Name="Windows 设置">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{DynamicResource IconFont}" FontSize="15" Width="20" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="Windows 设置" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavUpdates" Style="{DynamicResource NavItem}" Tag="updates" Click="Nav_Click" AutomationProperties.Name="软件更新">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFont}" FontSize="15" Width="20" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="软件更新" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavLogs" Style="{DynamicResource NavItem}" Tag="logs" Click="Nav_Click" AutomationProperties.Name="服务日志">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C3;" FontFamily="{DynamicResource IconFont}" FontSize="15" Width="20" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="服务日志" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavBackups" Style="{DynamicResource NavItem}" Tag="backups" Click="Nav_Click" AutomationProperties.Name="数据备份">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="{DynamicResource IconFont}" FontSize="15" Width="20" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="数据备份" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!-- 导航底部配重：把 600px 的空白变成有用的三行状态 -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="11,0,11,0">
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,0,0,10" />
                        <TextBlock x:Name="RailStatusText" Style="{DynamicResource Hint}" Foreground="{DynamicResource TextTertiary}"
                                   Text="正在读取运行状态" TextWrapping="Wrap" />
                        <TextBlock Style="{DynamicResource Hint}" Foreground="{DynamicResource TextTertiary}" Margin="0,6,0,0"
                                   Text="关闭控制中心后后台服务继续运行" TextWrapping="Wrap" />
                        <TextBlock Style="{DynamicResource Hint}" Foreground="{DynamicResource TextTertiary}" Margin="0,6,0,0"
                                   Text="Tab 切换控件 · Enter 执行" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 内容列 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="PageHost" Grid.Row="0">
                    <!-- 运行总览 -->
                    <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto" Padding="{DynamicResource PagePadding}">
                        <StackPanel>
                            <TextBlock Text="运行总览" Style="{DynamicResource PageTitle}" />
                            <TextBlock x:Name="CheckedText" Style="{DynamicResource Hint}" Margin="0,6,0,18" MinHeight="18" />

                            <Border x:Name="OverallBanner" Style="{DynamicResource StatusBanner}" Margin="{DynamicResource CardGap}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <!-- 整页只在这一处用文字说明"正在检查"，其余位置用骨架条 -->
                                        <TextBlock x:Name="OverallState" Text="正在检查运行状态…" Style="{DynamicResource SectionTitle}" />
                                        <TextBlock x:Name="DiagnosisText" Style="{DynamicResource Body}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"
                                                   AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                        <Button x:Name="BannerStartButton" Content="启动服务" Style="{DynamicResource PrimaryButton}" Click="Start_Click" Margin="0,0,8,0" />
                                        <Button Content="查看日志" Click="OpenLogs_Click" Margin="0,0,4,0" />
                                        <Button Content="导出诊断摘要" Style="{DynamicResource TextButton}" Click="ExportDiagnosis_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <UniformGrid x:Name="MetricGrid" Columns="2" Margin="{DynamicResource CardGap}">
                                <Border Style="{DynamicResource Card}" Margin="{DynamicResource CardGapRight}">
                                    <StackPanel>
                                        <TextBlock Text="Novora 服务" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                        <Grid Margin="0,8,0,5">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="ServiceDot" Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center"
                                                         Fill="{DynamicResource TextTertiary}" />
                                                <TextBlock x:Name="ServiceState" Text="—" Style="{DynamicResource MetricValue}" />
                                            </StackPanel>
                                            <Border x:Name="ServiceSkeleton" Style="{DynamicResource Skeleton}" Width="118" Height="20" HorizontalAlignment="Left" />
                                        </Grid>
                                        <TextBlock Text="后台业务服务" Style="{DynamicResource Hint}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource Card}" Margin="{DynamicResource CardGap}">
                                    <StackPanel>
                                        <TextBlock Text="PostgreSQL" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                        <Grid Margin="0,8,0,5">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="DatabaseDot" Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center"
                                                         Fill="{DynamicResource TextTertiary}" />
                                                <TextBlock x:Name="DatabaseState" Text="—" Style="{DynamicResource MetricValue}" />
                                            </StackPanel>
                                            <Border x:Name="DatabaseSkeleton" Style="{DynamicResource Skeleton}" Width="118" Height="20" HorizontalAlignment="Left" />
                                        </Grid>
                                        <TextBlock Text="Novora 独立数据库实例" Style="{DynamicResource Hint}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource Card}" Margin="{DynamicResource GutterRight}">
                                    <StackPanel>
                                        <TextBlock Text="HTTP 健康" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                        <Grid Margin="0,8,0,5">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="HealthDot" Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center"
                                                         Fill="{DynamicResource TextTertiary}" />
                                                <TextBlock x:Name="HealthState" Text="—" Style="{DynamicResource MetricValue}" />
                                            </StackPanel>
                                            <Border x:Name="HealthSkeleton" Style="{DynamicResource Skeleton}" Width="118" Height="20" HorizontalAlignment="Left" />
                                        </Grid>
                                        <TextBlock x:Name="PortText" Text="端口 —" Style="{DynamicResource Hint}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="局域网地址（不代表外部连通性）" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                        <Grid Margin="0,8,0,5">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="LanDot" Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center"
                                                         Fill="{DynamicResource TextTertiary}" />
                                                <TextBlock x:Name="LanState" Text="—" Style="{DynamicResource MetricValue}" />
                                            </StackPanel>
                                            <Border x:Name="LanSkeleton" Style="{DynamicResource Skeleton}" Width="118" Height="20" HorizontalAlignment="Left" />
                                        </Grid>
                                        <TextBlock x:Name="LanText" Text="地址 —" Style="{DynamicResource Hint}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- 两张卡并排：原来每条都是全宽横带，右半边永远空着 -->
                            <UniformGrid Columns="2">
                                <Border Style="{DynamicResource Card}" Margin="{DynamicResource GutterRight}">
                                    <StackPanel>
                                        <TextBlock Text="本机访问与运行细节" Style="{DynamicResource SectionTitle}" />
                                        <Grid Margin="0,9,0,0">
                                            <TextBlock x:Name="ProcessText" Style="{DynamicResource Hint}" TextWrapping="Wrap" />
                                            <Border x:Name="ProcessSkeleton" Style="{DynamicResource Skeleton}" Width="240" Height="12" HorizontalAlignment="Left" />
                                        </Grid>
                                        <WrapPanel Margin="0,14,0,0">
                                            <Button Content="复制本机地址" Click="CopyLocal_Click" Margin="0,0,8,8" />
                                            <Button Content="复制局域网地址" Click="CopyLan_Click" Margin="0,0,8,8" />
                                            <Button Content="复制诊断信息" Style="{DynamicResource TextButton}" Click="CopyDiagnosis_Click" Margin="0,0,8,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="服务操作" Style="{DynamicResource SectionTitle}" />
                                        <TextBlock Text="启动、重启、停止都会弹出管理员授权；取消授权不会改动服务状态。" Style="{DynamicResource Hint}"
                                                   Margin="0,6,0,16" MaxWidth="360" HorizontalAlignment="Left" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="StartButton" Content="启动服务" Click="Start_Click" Margin="0,0,8,0" />
                                            <Button x:Name="RestartButton" Content="重启服务" Click="Restart_Click" Margin="0,0,8,0" />
                                            <Button x:Name="StopButton" Content="停止服务" Style="{DynamicResource DangerButton}" Click="Stop_Click" />
                                        </StackPanel>
                                        <TextBlock Text="服务以 LocalSystem 账户运行；端口与防火墙规则在 Windows 设置里修改。" Style="{DynamicResource Hint}"
                                                   Foreground="{DynamicResource TextTertiary}" Margin="0,14,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Windows 设置 / 初始化向导 -->
                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="{DynamicResource PagePadding}">
                        <!-- 只限宽不左对齐：加了 HorizontalAlignment="Left" 会让整列收缩到内容宽度，
                             而不是"撑满但封顶"。 -->
                        <StackPanel MaxWidth="1040">
                            <TextBlock x:Name="SettingsTitle" Text="Windows 设置" Style="{DynamicResource PageTitle}" />

                            <Border x:Name="WizardProgress" Visibility="Collapsed" Margin="0,14,0,18" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="0,0,0,1">
                                <UniformGrid Columns="4">
                                    <Border x:Name="Step1" Style="{DynamicResource StepItem}" local:Mark.Phase="now">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="Step1Badge" Style="{DynamicResource StepBadge}" local:Mark.Phase="now">
                                                <Grid Width="20" Height="20">
                                                    <TextBlock x:Name="Step1Number" Text="1" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                    <TextBlock x:Name="Step1Check" Text="✓" FontSize="11" Visibility="Collapsed"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Success}" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="环境检查" Margin="8,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Hint}" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="Step2" Style="{DynamicResource StepItem}" local:Mark.Phase="todo">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="Step2Badge" Style="{DynamicResource StepBadge}" local:Mark.Phase="todo">
                                                <Grid Width="20" Height="20">
                                                    <TextBlock x:Name="Step2Number" Text="2" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                    <TextBlock x:Name="Step2Check" Text="✓" FontSize="11" Visibility="Collapsed"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Success}" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="参数设置" Margin="8,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Hint}" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="Step3" Style="{DynamicResource StepItem}" local:Mark.Phase="todo">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="Step3Badge" Style="{DynamicResource StepBadge}" local:Mark.Phase="todo">
                                                <Grid Width="20" Height="20">
                                                    <TextBlock x:Name="Step3Number" Text="3" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                    <TextBlock x:Name="Step3Check" Text="✓" FontSize="11" Visibility="Collapsed"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Success}" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="确认应用" Margin="8,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Hint}" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="Step4" Style="{DynamicResource StepItem}" local:Mark.Phase="todo">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="Step4Badge" Style="{DynamicResource StepBadge}" local:Mark.Phase="todo">
                                                <Grid Width="20" Height="20">
                                                    <TextBlock x:Name="Step4Number" Text="4" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                    <TextBlock x:Name="Step4Check" Text="✓" FontSize="11" Visibility="Collapsed"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Success}" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="结果" Margin="8,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Hint}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Border>

                            <Border x:Name="InspectionPanel" Style="{DynamicResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="检查运行文件与 Windows 配置" Style="{DynamicResource SectionTitle}" />
                                    <TextBlock x:Name="InspectionSummary" Text="尚未检查" Style="{DynamicResource Hint}" Margin="0,6,0,10"
                                               AutomationProperties.Name="检查结果摘要" AutomationProperties.LiveSetting="Polite" />
                                    <ProgressBar x:Name="InspectionProgress" Visibility="Collapsed" Margin="0,0,0,10"
                                                 AutomationProperties.Name="初始化环境检查进度" />
                                    <ItemsControl x:Name="InspectionItems" AutomationProperties.Name="逐项检查结果">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderWeak}" BorderThickness="0,0,0,1" Padding="0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="92" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Style="{DynamicResource Pill}" HorizontalAlignment="Left">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="{DynamicResource Warning}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="正常">
                                                                                    <Setter Property="Fill" Value="{DynamicResource Success}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Blocking}" Value="True">
                                                                                    <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="12">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="正常">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Blocking}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Detail}" Style="{DynamicResource Hint}" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button x:Name="InspectButton" Content="重新检查系统" Click="Inspect_Click" Margin="0,0,8,0" />
                                        <CheckBox x:Name="OnlyProblems" Content="只看未通过项" Margin="0,0,12,0" VerticalContentAlignment="Center"
                                                  Checked="OnlyProblems_Changed" Unchecked="OnlyProblems_Changed" />
                                        <TextBlock x:Name="InspectionCount" Style="{DynamicResource Hint}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="OptionsPanel" Style="{DynamicResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="启动、访问与备份" Style="{DynamicResource SectionTitle}" />
                                    <TextBlock Style="{DynamicResource Body}" Margin="0,7,0,14" MaxWidth="820" HorizontalAlignment="Left"
                                               Text="初始化会准备配置并注册服务；应用后会启动数据库、检查连接、准备业务库并验证服务健康，系统会请求管理员权限。修改端口会重启正在运行的服务。" />
                                    <CheckBox x:Name="ServiceAuto" Content="Novora 服务开机自动启动" IsChecked="True" />
                                    <CheckBox x:Name="DatabaseAuto" Content="数据库开机自动启动" IsChecked="True" />
                                    <CheckBox x:Name="AutoRestart" Content="服务异常后自动重启" IsChecked="True" />
                                    <CheckBox x:Name="LanAccess" Content="允许本地子网访问（所有 Windows 网络配置）" IsChecked="True" />
                                    <CheckBox x:Name="TrayStartup" Content="登录后启动托盘" IsChecked="True" />
                                    <CheckBox x:Name="DesktopShortcut" Content="创建桌面快捷方式" IsChecked="True" />
                                    <CheckBox x:Name="StartMenuShortcut" Content="创建开始菜单快捷方式" IsChecked="True" />
                                    <CheckBox x:Name="DailyBackup" Content="每天 02:00 自动备份（计算机需处于开机状态）" />

                                    <Border BorderBrush="{DynamicResource BorderWeak}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,14,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="服务端口" Style="{DynamicResource FieldLabel}" />
                                                <TextBox x:Name="PortInput" Width="110" HorizontalAlignment="Left" Text="3000" MaxLength="5"
                                                         VerticalContentAlignment="Center" AutomationProperties.Name="服务端口" />
                                                <TextBlock Style="{DynamicResource Hint}" Margin="0,6,0,0" Text="1–65535；改动会重启业务服务。" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="普通备份保留份数" Style="{DynamicResource FieldLabel}" />
                                                <TextBox x:Name="KeepInput" Width="110" HorizontalAlignment="Left" Text="14" MaxLength="3"
                                                         VerticalContentAlignment="Center" AutomationProperties.Name="备份保留份数" />
                                                <TextBlock Style="{DynamicResource Hint}" Margin="0,6,0,0" Text="1–365；保护备份不参与自动清理。" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBox x:Name="ReviewText" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" MinHeight="160"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" AutomationProperties.Name="初始化确认" />
                            <TextBox x:Name="ApplyResult" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" MinHeight="130" MaxHeight="300"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" AutomationProperties.Name="设置应用结果" />
                            <Button x:Name="CredentialButton" Content="查看初始登录凭据" Click="Credential_Click" Visibility="Collapsed"
                                    HorizontalAlignment="Left" Margin="0,0,0,12" />

                            <!-- 向导底部配重：主操作靠右、左边给一条常驻说明，不再让"下一步"孤零零悬在左侧 -->
                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{DynamicResource Hint}" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"
                                               MaxWidth="440" HorizontalAlignment="Left" TextWrapping="Wrap"
                                               Text="这些开关只影响本机 Windows 配置与 Novora 服务，不会改动学校业务数据。" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="WizardBack" Content="上一步" Click="WizardBack_Click" Visibility="Collapsed" Margin="0,0,8,0" />
                                        <Button x:Name="WizardNext" Content="下一步" Click="WizardNext_Click" Visibility="Collapsed" Margin="0,0,8,0"
                                                Style="{DynamicResource PrimaryButton}" />
                                        <Button x:Name="ApplyButton" Content="应用 Windows 设置" Click="Apply_Click" Style="{DynamicResource PrimaryButton}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 软件更新 -->
                    <ScrollViewer x:Name="UpdatesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="{DynamicResource PagePadding}">
                        <local:UpdatesView x:Name="UpdatesPanel" />
                    </ScrollViewer>

                    <!-- 服务日志 -->
                    <Grid x:Name="LogsPage" Visibility="Collapsed" Margin="{DynamicResource PagePadding}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="服务日志" Style="{DynamicResource PageTitle}" />
                            <TextBlock Text="最多显示最近 300 行 / 128 KB；每 10 秒更新。导出当前筛选结果。" Style="{DynamicResource Body}" Margin="0,7,0,16" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="LogSource" SelectedIndex="0" Width="145" Margin="0,0,8,0" SelectionChanged="LogOptions_Changed"
                                          AutomationProperties.Name="日志来源">
                                    <ComboBoxItem Content="业务服务" Tag="novora-service.log" />
                                    <ComboBoxItem Content="初始化" Tag="initialize.log" />
                                    <ComboBoxItem Content="安装程序" Tag="installer.log" />
                                </ComboBox>
                                <ComboBox x:Name="LogLevel" SelectedIndex="0" Width="118" Margin="0,0,8,0" SelectionChanged="LogOptions_Changed"
                                          AutomationProperties.Name="日志级别">
                                    <ComboBoxItem Content="全部" />
                                    <ComboBoxItem Content="错误" />
                                    <ComboBoxItem Content="警告" />
                                </ComboBox>
                                <TextBox x:Name="LogSearch" Width="200" Margin="0,0,8,0" TextChanged="LogSearch_Changed"
                                         VerticalContentAlignment="Center" AutomationProperties.Name="搜索日志" ToolTip="搜索关键字（忽略大小写）" />
                                <Button Content="导出" Click="ExportLog_Click" Margin="0,0,8,0" />
                                <Button Content="日志目录" Style="{DynamicResource GhostButton}" Click="LogsFolder_Click" />
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <ListBox x:Name="LogLines" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling" BorderBrush="{DynamicResource Border}"
                                     AutomationProperties.Name="最近服务日志">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="0,0,0,1" Padding="12,3">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBackground}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoft}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextWrapping="NoWrap"
                                                   Foreground="{DynamicResource TextSecondary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tone}" Value="error">
                                                            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tone}" Value="warn">
                                                            <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="LogEmpty" Text="当前筛选条件下没有匹配的日志行。" Style="{DynamicResource Hint}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <CheckBox x:Name="PauseLogs" Content="暂停更新" Margin="0,0,18,0" VerticalContentAlignment="Center" />
                            <CheckBox x:Name="AutoScroll" Content="自动滚动到底部" IsChecked="True" Margin="0,0,18,0" VerticalContentAlignment="Center" />
                            <TextBlock x:Name="LogHits" Style="{DynamicResource Hint}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- 数据备份 -->
                    <Grid x:Name="BackupsPage" Visibility="Collapsed" Margin="{DynamicResource PagePadding}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="数据备份" Style="{DynamicResource PageTitle}" />
                            <TextBlock Style="{DynamicResource Body}" Margin="0,7,0,16" MaxWidth="900" HorizontalAlignment="Left"
                                       Text="显示最近 100 份；类型列按写入方约定区分常规、更新前保护与恢复前保护，保护备份不参与自动清理。校验只检查归档结构。恢复会暂停服务并先创建保护备份。备份计划在 Windows 设置中配置。" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="创建备份" Style="{DynamicResource PrimaryButton}" Click="Backup_Click" Margin="0,0,8,0" />
                                <Button x:Name="ValidateBackupButton" Content="校验所选" Click="ValidateBackup_Click" Margin="0,0,8,0" IsEnabled="False" />
                                <Button x:Name="RestoreBackupButton" Content="恢复所选" Click="RestoreBackup_Click" Margin="0,0,8,0" IsEnabled="False" />
                                <Button x:Name="DeleteBackupButton" Content="删除所选" Style="{DynamicResource DangerButton}" Click="DeleteBackup_Click"
                                        Margin="0,0,8,0" IsEnabled="False" />
                                <Button Content="打开备份目录" Style="{DynamicResource GhostButton}" Click="BackupsFolder_Click" />
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <ListView x:Name="BackupList" SelectionChanged="BackupList_SelectionChanged" ScrollViewer.CanContentScroll="True"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      AutomationProperties.Name="最近备份">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="备份文件" DisplayMemberBinding="{Binding Name}" Width="360" />
                                        <GridViewColumn Header="类型" DisplayMemberBinding="{Binding Kind}" Width="120" />
                                        <GridViewColumn Header="大小" DisplayMemberBinding="{Binding Size}" Width="110" />
                                        <GridViewColumn Header="修改时间" DisplayMemberBinding="{Binding Modified}" Width="190" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <Border x:Name="BackupEmpty" Style="{DynamicResource CardSoft}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed" Padding="24,20">
                                <StackPanel>
                                    <TextBlock Text="还没有备份文件" Style="{DynamicResource SectionTitle}" HorizontalAlignment="Center" />
                                    <TextBlock Style="{DynamicResource Hint}" Margin="0,6,0,0" HorizontalAlignment="Center" MaxWidth="320" TextAlignment="Center"
                                               Text="点“创建备份”会立即导出一份数据库归档；也可在 Windows 设置里开启每天 02:00 自动备份。" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBox x:Name="BackupResult" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="130"
                                 Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="备份操作结果" />
                    </Grid>
                </Grid>

                <!-- 操作进度：仅在执行或失败时出现 -->
                <Border x:Name="OperationPanel" Grid.Row="1" Style="{DynamicResource Card}" Margin="28,0,28,10" Visibility="Collapsed"
                        AutomationProperties.LiveSetting="Polite">
                    <StackPanel>
                        <TextBlock x:Name="OperationItem" Text="正在加载配置" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ProgressBar x:Name="OperationBar" IsIndeterminate="True" Margin="0,10,0,8" AutomationProperties.Name="当前操作进度" />
                        <TextBlock x:Name="OperationDetail" Text="请稍候…" Style="{DynamicResource Hint}" />
                        <WrapPanel x:Name="FailureActions" Visibility="Collapsed" Margin="0,10,0,0">
                            <Button x:Name="RetryOperation" Content="重试此操作" Click="RetryOperation_Click" Margin="0,0,8,0" />
                            <Button Content="查看日志" Click="OpenLogs_Click" Margin="0,0,8,0" />
                            <Button Content="导出诊断摘要" Style="{DynamicResource GhostButton}" Click="ExportDiagnosis_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 状态栏 -->
                <Border Grid.Row="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                        Padding="28,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MessageText" Style="{DynamicResource Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite" />
                        <StackPanel x:Name="PassiveWait" Grid.Column="1" Visibility="Hidden" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PassiveItem" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}" />
                            <ProgressBar x:Name="PassiveBar" Height="3" Margin="0,5,0,0" BorderThickness="0" AutomationProperties.Name="系统检查进度" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="OpenWebButton" Content="打开管理端" Click="OpenWeb_Click" IsEnabled="False" Margin="0,0,8,0" />
                            <Button Content="刷新状态" Click="Refresh_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
