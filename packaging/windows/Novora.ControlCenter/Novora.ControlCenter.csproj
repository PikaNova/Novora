<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NovoraLauncher</AssemblyName>
    <RootNamespace>Novora.ControlCenter</RootNamespace>
    <ApplicationIcon>..\Assets\favicon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup><Resource Include="..\Assets\favicon.ico" Link="favicon.ico" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../Novora.Update/Novora.Update.csproj" /></ItemGroup>
</Project>
