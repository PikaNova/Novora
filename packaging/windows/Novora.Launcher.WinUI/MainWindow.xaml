<Window
    x:Class="Novora.Launcher.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid" RequestedTheme="Light" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="HeaderBar" Padding="28,28,28,16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Image Source="Assets/favicon.ico" Width="32" Height="32" Margin="0,0,14,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Grid.Column="1" Text="NOVORA" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Grid.Column="1" x:Name="HeaderSubtitle" Text="Windows 初始化" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBlock x:Name="VersionText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" IsSettingsVisible="False" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" SelectionChanged="Navigation_SelectionChanged" Background="Transparent" IsBackEnabled="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="环境检查" Tag="environment" Icon="Accept" Foreground="{ThemeResource NavigationViewItemForeground}" />
                <NavigationViewItem Content="Windows 服务" Tag="services" Icon="Setting" Foreground="{ThemeResource NavigationViewItemForeground}" />
                <NavigationViewItem Content="局域网访问" Tag="network" Icon="Globe" Foreground="{ThemeResource NavigationViewItemForeground}" />
                <NavigationViewItem Content="托盘与快捷方式" Tag="shortcuts" Icon="Folder" Foreground="{ThemeResource NavigationViewItemForeground}" />
                <NavigationViewItem Content="完成" Tag="finish" Icon="Accept" Foreground="{ThemeResource NavigationViewItemForeground}" />
            </NavigationView.MenuItems>
            <ContentControl x:Name="ContentHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </NavigationView>
        <CommandBar x:Name="ActionBar" Grid.Row="2" DefaultLabelPosition="Right" HorizontalContentAlignment="Right" Padding="24,6">
            <AppBarButton x:Name="BackButton" Icon="Back" Label="上一步" Click="BackButton_Click" />
            <AppBarButton x:Name="NextButton" Icon="Forward" Label="下一步" Click="NextButton_Click" />
        </CommandBar>
    </Grid>
</Window>
