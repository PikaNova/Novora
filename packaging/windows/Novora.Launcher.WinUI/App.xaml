<Application
    x:Class="Novora.Launcher.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <!-- Explicit light palette for the unpackaged WinUI 3 launcher. -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5B5B5B" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#6B6B6B" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#8A8A8A" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#D6D6D6" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#D6D6D6" />
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#F9F9F9" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#EBEBEB" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#BFBFBF" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#D6D6D6" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0067C0" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
            <!-- Explicit light control text resources. The launcher is
                 unpackaged, so host theme defaults must not produce white
                 text on the light surfaces. -->
            <SolidColorBrush x:Key="ButtonForeground" Color="#1F1F1F" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#1F1F1F" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#1F1F1F" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#8A8A8A" />
            <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F3F3F3" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#EBEBEB" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#BFBFBF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#8A8A8A" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#6B6B6B" />
            <SolidColorBrush x:Key="AppBarButtonForeground" Color="#1F1F1F" />
            <SolidColorBrush x:Key="AppBarButtonForegroundPointerOver" Color="#1F1F1F" />
            <SolidColorBrush x:Key="AppBarButtonForegroundPressed" Color="#1F1F1F" />
            <SolidColorBrush x:Key="AppBarButtonForegroundDisabled" Color="#8A8A8A" />
            <SolidColorBrush x:Key="AppBarButtonLabelForeground" Color="#1F1F1F" />
            <SolidColorBrush x:Key="CommandBarForeground" Color="#1F1F1F" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#1F1F1F" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#1F1F1F" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#1F1F1F" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#1F1F1F" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#1F1F1F" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundDisabled" Color="#8A8A8A" />
            <SolidColorBrush x:Key="ToggleSwitchHeaderForeground" Color="#1F1F1F" />
            <SolidColorBrush x:Key="ToggleSwitchOnContentForeground" Color="#1F1F1F" />
            <SolidColorBrush x:Key="ToggleSwitchOffContentForeground" Color="#5B5B5B" />
            <SolidColorBrush x:Key="ToggleSwitchHeaderForegroundDisabled" Color="#8A8A8A" />
            <SolidColorBrush x:Key="InfoBarForeground" Color="#1F1F1F" />
            <SolidColorBrush x:Key="InfoBarTitleForeground" Color="#1F1F1F" />
            <SolidColorBrush x:Key="InfoBarMessageForeground" Color="#5B5B5B" />
            <SolidColorBrush x:Key="ContentDialogForeground" Color="#1F1F1F" />
            <SolidColorBrush x:Key="ContentDialogTitleForeground" Color="#1F1F1F" />
            <SolidColorBrush x:Key="ContentDialogContentForeground" Color="#1F1F1F" />
            <SolidColorBrush x:Key="ContentDialogButtonForeground" Color="#1F1F1F" />
            <SolidColorBrush x:Key="ContentDialogButtonForegroundPointerOver" Color="#1F1F1F" />
            <SolidColorBrush x:Key="ContentDialogButtonForegroundPressed" Color="#1F1F1F" />
            <SolidColorBrush x:Key="ContentDialogPrimaryButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="FlyoutPresenterForeground" Color="#1F1F1F" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterForeground" Color="#1F1F1F" />
            <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#005FB8" />
            <SolidColorBrush x:Key="TextBoxForeground" Color="#1F1F1F" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#1F1F1F" />
            <SolidColorBrush x:Key="CheckBoxForeground" Color="#1F1F1F" />
            <!-- WinAppSDK 1.7 NavigationView template fallbacks for unpackaged apps. -->
            <SolidColorBrush x:Key="TabViewButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TabViewButtonBackgroundPointerOver" Color="#0F000000" />
            <SolidColorBrush x:Key="TabViewButtonBackgroundPressed" Color="#16000000" />
            <SolidColorBrush x:Key="TabViewButtonBackgroundSelected" Color="#0A000000" />
            <SolidColorBrush x:Key="TabViewButtonBackgroundSelectedPointerOver" Color="#14000000" />
            <SolidColorBrush x:Key="TabViewButtonBackgroundSelectedPressed" Color="#1F000000" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
